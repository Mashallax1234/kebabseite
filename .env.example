# Kopieren nach .env.local und ausfüllen.
# Ohne Supabase-Werte läuft die Seite im Demo-Modus (Daten in .data/demo.json).

# 'supabase' oder 'demo' (leer = automatisch: supabase, sobald SUPABASE_URL gesetzt ist)
DATA_BACKEND=

# Supabase-Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Öffentliche Adresse der Seite (für Bestätigungsmails, Google-Login, Link-Vorschauen).
# In Produktion Pflicht.
SITE_URL=http://localhost:3000

# NIE den Supabase Service-Role-Key hier eintragen – er wird nicht gebraucht.
